PORT=8080
# clerk (default when CLERK_SECRET_KEY is set) or jwt for legacy demo login
AUTH_MODE=clerk

# From backend/ after linking the same Clerk app:
#   npx -y clerk@latest link --app app_3KifmUIvMZ5YD4O9vl7C8QOUe7y
#   npx -y clerk@latest env pull
# Keys are written to .env.local (gitignored).

CLERK_SECRET_KEY=
JWT_SECRET=dev-jwt-secret
# Use port 5433 when compose maps 5433:5432 (see root docker-compose.yml)
DATABASE_URL=postgres://hackathon:hackathon@127.0.0.1:5433/hackathon
# When DATABASE_URL is unset, household data uses local SQLite:
HOUSEHOLD_SQLITE_PATH=./data/household.sqlite
LOG_LEVEL=warn

# gemini, groq, or openai — household coach needs groq + GROQ_API_KEY
AI_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Uplift Orator TTS (household-coach/speak and /voice)
UPLIFT_API_KEY=


UPLIFT_VOICE_ID=v_8eelc901
UPLIFT_TTS_FORMAT=MP3_22050_128
# UPLIFT_PHRASE_REPLACEMENT_CONFIG_ID=
