PORT=8080
# clerk (default when CLERK_SECRET_KEY is set) or jwt for legacy demo login
AUTH_MODE=clerk

# From backend/ after linking the same Clerk app:
#   npx -y clerk@latest link --app app_3KifmUIvMZ5YD4O9vl7C8QOUe7y
#   npx -y clerk@latest env pull
# Keys are written to .env.local (gitignored).

CLERK_SECRET_KEY=
JWT_SECRET=dev-jwt-secret
DATABASE_URL=postgres://hackathon:hackathon@localhost:5432/hackathon
# When DATABASE_URL is unset, household data uses local SQLite:
HOUSEHOLD_SQLITE_PATH=./data/household.sqlite
LOG_LEVEL=warn

# gemini, groq, or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
